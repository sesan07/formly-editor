{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "start:docs",
      "label": "start:docs",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "astro v",
          "endsPattern": "Local\\s+https?://"
        }
      }
    },
    {
      "type": "npm",
      "script": "lint",
      "label": "lint",
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "test",
      "label": "test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "build",
      "label": "build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "build:studio",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "type": "npm",
      "script": "build:core",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "type": "npm",
      "script": "build:material",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "type": "npm",
      "script": "build:docs",
      "label": "build:docs",
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "check:docs",
      "label": "check:docs",
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "preview:docs",
      "label": "preview:docs",
      "dependsOn": "build:docs",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "astro v",
          "endsPattern": "Local\\s+https?://"
        }
      }
    },
    {
      "type": "npm",
      "script": "test:studio",
      "group": "test",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "test:core",
      "group": "test",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "test:material",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
