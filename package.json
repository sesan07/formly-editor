{
  "name": "formly-editor",
  "version": "0.0.0",
  "author": "Samuel Esan (https://github.com/sesan07)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sesan07/formly-editor.git"
  },
  "homepage": "https://formlystudio.com/",
  "workspaces": [
    "apps/docs"
  ],
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "start": "ng serve studio --host 0.0.0.0",
    "start:docs": "npm run dev --workspace @formly-editor/docs",
    "build": "npm run build:builder-material && npm run build:studio && npm run build:docs",
    "build:studio": "ng build studio",
    "build:core": "ng build core",
    "build:material": "ng build material",
    "prebuild:builder-material": "npm run build:core && npm run build:material",
    "build:builder-material": "ng build builder-material",
    "build:docs": "npm run build --workspace @formly-editor/docs",
    "check:docs": "npm run check --workspace @formly-editor/docs",
    "preview:docs": "npm run preview --workspace @formly-editor/docs",
    "test:e2e": "playwright test --config apps/studio/playwright.config.ts",
    "test": "npm run test:studio && npm run test:core && npm run test:material && npm run test:builder-material",
    "test:studio": "ng test studio --watch=false",
    "test:core": "ng test core --watch=false",
    "test:material": "ng test material --watch=false",
    "test:builder-material": "ng test builder-material --watch=false",
    "lint": "ng lint studio && ng lint core && ng lint material && ng lint builder-material"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^21.2.9",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/material": "^21.2.9",
    "@angular/platform-browser": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@dragdroptouch/drag-drop-touch": "^2.0.3",
    "@ngx-formly/bootstrap": "^7.1.0",
    "@ngx-formly/core": "^7.1.0",
    "@ngx-formly/material": "^7.1.0",
    "@ngx-formly/ng-zorro-antd": "^7.1.0",
    "@ngx-formly/primeng": "^7.1.0",
    "@primeuix/themes": "^2.0.3",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.15",
    "file-saver": "^2.0.5",
    "js-beautify": "^1.15.4",
    "lodash-es": "^4.17.21",
    "marked": "^18.0.13",
    "mutative": "^1.3.0",
    "ng-zorro-antd": "^21.3.3",
    "ngx-drag-drop": "^21.0.6",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-primeui": "^0.6.1",
    "terser": "^5.51.2",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.1.3",
    "@analogjs/vitest-angular": "2.1.3",
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.9",
    "@eslint/js": "^9.8.0",
    "@playwright/test": "^1.36.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/file-saver": "^2.0.7",
    "@types/js-beautify": "^1.14.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "angular-eslint": "21.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.7",
    "jsdom": "~28.0.0",
    "less": "^4.9.1",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.9"
  }
}
