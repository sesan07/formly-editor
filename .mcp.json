{
	"mcpServers": {
		"angular-cli": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@angular/cli",
				"mcp"
			],
			"tools": [
				"*"
			]
		},
		"Astro docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp",
			"tools": [
				"*"
			]
		},
		"primeng": {
			"type": "local",
			"command": "npx",
			"args": [
				"-y",
				"@primeng/mcp"
			],
			"tools": [
				"*"
			]
		}
	}
}
