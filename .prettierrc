{
  "plugins": ["prettier-plugin-tailwindcss"],
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "singleAttributePerLine": true,
  "tailwindStylesheet": "./apps/studio/src/styles.css",
  "tailwindFunctions": ["cva"],
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ]
}
