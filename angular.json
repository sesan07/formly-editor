{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "libs",
  "projects": {
    "studio": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/studio",
      "sourceRoot": "apps/studio/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/studio",
            "browser": "apps/studio/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "apps/studio/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/studio/public"
              }
            ],
            "styles": [
              "apps/studio/src/styles.css",
              "apps/studio/src/material-theme.scss",
              "apps/studio/src/bootstrap.scss",
              "apps/studio/src/ng-zorro.less",
              {
                "input": "apps/studio/src/ng-zorro-dark.less",
                "bundleName": "ng-zorro-dark",
                "inject": false
              }
            ],
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": ["import"]
              },
              "includePaths": ["node_modules"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "5.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": false
            },
            "development": {
              "fileReplacements": [
                {
                  "replace": "apps/studio/src/environments/environment.ts",
                  "with": "apps/studio/src/environments/environment.development.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "studio:build:production"
            },
            "development": {
              "buildTarget": "studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/studio/**/*.ts", "apps/studio/**/*.html"],
            "eslintConfig": "apps/studio/eslint.config.js"
          }
        }
      }
    },
    "core": {
      "projectType": "library",
      "root": "libs/core",
      "sourceRoot": "libs/core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/core/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/core/**/*.ts", "libs/core/**/*.html"],
            "eslintConfig": "libs/core/eslint.config.js"
          }
        }
      }
    },
    "material": {
      "projectType": "library",
      "root": "libs/ui/material",
      "sourceRoot": "libs/ui/material/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/ui/material/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/ui/material/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/ui/material/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/ui/material/**/*.ts", "libs/ui/material/**/*.html"],
            "eslintConfig": "libs/ui/material/eslint.config.js"
          }
        }
      }
    },
    "builder-material": {
      "projectType": "library",
      "root": "libs/ui/builder-material",
      "sourceRoot": "libs/ui/builder-material/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/ui/builder-material/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/ui/builder-material/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/ui/builder-material/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "libs/ui/builder-material/**/*.ts",
              "libs/ui/builder-material/**/*.html"
            ],
            "eslintConfig": "libs/ui/builder-material/eslint.config.js"
          }
        }
      }
    }
  }
}
